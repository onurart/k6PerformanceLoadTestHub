# Hedef yalnızca origin olmalıdır; path eklemeyin.
TARGET_URL="https://games.hubgmng.com"
ALLOWED_HOST="games.hubgmng.com"

# Endpoint listesini gerçek uygulama yollarınıza göre düzenleyin.
ENDPOINTS_JSON='[
  {"name":"home","method":"GET","path":"/","expected_statuses":[200]},
  {"name":"jackpot","method":"GET","path":"/api/jackpot","expected_statuses":[200]},
  {"name":"okey101_tables","method":"GET","path":"/api/okey101/tables","expected_statuses":[200]},
  {"name":"backgammon_tables","method":"GET","path":"/api/backgammon/tables","expected_statuses":[200]},
  {"name":"batak_tables","method":"GET","path":"/api/batak/tables","expected_statuses":[200]}
]'

# smoke | load | stress | spike | volume
SCENARIO="volume"

# Tek veya dağıtık bütün makinelerin toplam orta ölçekli limitleri.
MAX_RPS="7"
MAX_VUS="60"
TEST_DURATION="2m"
WARMUP_DURATION="30s"

# volume senaryosu: toplam ziyaret/istek sayısını bu süreye eşit yayar.
TOTAL_REQUESTS="50000"
TOTAL_DURATION="2h"

# Otomatik durdurma sınırları.
P95_LIMIT_MS="2000"
ERROR_RATE_LIMIT="0.30"
REQUEST_TIMEOUT="10s"

# Tek makine ayarları. Dağıtık kullanımda her makinede düzenleyin.
REGION_TAG="local"
MACHINE_COUNT="1"
MACHINE_INDEX="0"

# Dağıtık kullanım dışında boş bırakın.
COORDINATOR_URL=""

# true yapılırsa ayrıca makine tarafından okunabilir JSON özeti results/ içine yazar.
SAVE_JSON_RESULTS="true"

# Her HTTP yanıtını BAŞARILI/BAŞARISIZ olarak log dosyasına yazar.
LOG_EACH_REQUEST="false"

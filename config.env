# Hedef yalnızca origin olmalıdır; path eklemeyin.
TARGET_URL="https://games.hubgmng.com"

# Endpoint listesini gerçek uygulama yollarınıza göre düzenleyin.
ENDPOINTS_JSON='[{"name":"home","method":"GET","path":"/","expected_statuses":[200],"expected_body":""}]'

# smoke | load | stress | spike
SCENARIO="stress"

# Tek veya dağıtık bütün makinelerin toplam limitleri (Devasa trafik için artırıldı).
MAX_RPS="200"
MAX_VUS="5000"
TEST_DURATION="3h"
WARMUP_DURATION="10m"

# Otomatik durdurma sınırları (Yüksek trafik altında esnetildi).
P95_LIMIT_MS="3000"
ERROR_RATE_LIMIT="0.05"
REQUEST_TIMEOUT="5s"

# Tek makine ayarları. Dağıtık kullanımda her makinede düzenleyin.
REGION_TAG="local"
MACHINE_COUNT="1"
MACHINE_INDEX="0"

# Dağıtık kullanım dışında boş bırakın.
COORDINATOR_URL=""

# true yapılırsa ayrıca makine tarafından okunabilir JSON özeti results/ içine yazar.
SAVE_JSON_RESULTS="true"

# Her HTTP yanıtını BAŞARILI/BAŞARISIZ olarak log dosyasına yazar.
LOG_EACH_REQUEST="false"